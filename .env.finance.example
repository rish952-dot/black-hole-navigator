# NEVER commit a real private key. Inject these at runtime through your secret manager.
FINANCE_REAL_MONEY=false
FINANCE_REAL_DRY_RUN=true

# EVM connection
FINANCE_RPC_URL=https://YOUR_RPC_ENDPOINT
FINANCE_CHAIN_ID=1
FINANCE_PRIVATE_KEY=
FINANCE_DESTINATION=0x0000000000000000000000000000000000000000

# Asset: ETH, USDC or USDT
FINANCE_ASSET=USDC
# Required for USDC/USDT
FINANCE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Finance policy
FINANCE_PAYOUT_RATE=0.50
FINANCE_RESERVE_RATE=0.20
FINANCE_HOSTING_RATE=0.20
FINANCE_MIN_PAYOUT=1

# Real-money limits (asset units)
FINANCE_MAX_TRANSFER=10
FINANCE_MAX_DAILY_TRANSFER=25
FINANCE_MIN_NATIVE_RESERVE=0.01
FINANCE_CONFIRMATIONS=1

# Persistent safety/audit state
FINANCE_STATE_FILE=farm-output/real-money-state.json
FINANCE_AUDIT_FILE=farm-output/real-money-audit.jsonl
