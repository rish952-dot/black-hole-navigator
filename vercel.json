{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/farm", "destination": "/index.html" },
    { "source": "/mesh", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
